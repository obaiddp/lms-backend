# Copy to .env and configure as needed.

# Donation receipt email logos (by source site)
# Used in donation receipt email. Set to the same URL as each site's header logo.
# DONATION_RECEIPT_LOGO_URL_CEF_ORG_PK = cef.org.pk header logo full URL
# DONATION_RECEIPT_LOGO_URL_CEF_ONLINE_ACADEMY = cef-online-academy (CEF website) header logo full URL
# DONATION_RECEIPT_LOGO_URL = fallback when source_site is null or unknown
DONATION_RECEIPT_LOGO_URL=
DONATION_RECEIPT_LOGO_URL_CEF_ORG_PK=
DONATION_RECEIPT_LOGO_URL_CEF_ONLINE_ACADEMY=

# Public cef-dashboard origin for vault license payment links (no trailing slash)
# e.g. https://portal.cefonlineacademy.com
CEF_DASHBOARD_URL=

# Vault offline JWT (RS256). Default file path is storage/app/keys/vault-offline-jwt-rsa-private.pem
# Generate: openssl genrsa -out storage/app/keys/vault-offline-jwt-rsa-private.pem 2048
#           openssl rsa -in storage/app/keys/vault-offline-jwt-rsa-private.pem -pubout -out storage/app/keys/vault-offline-jwt-rsa-public.pem
# Copy the public PEM into cef-vault/assets/security/vault_jwt_public.pem for the app build.
VAULT_OFFLINE_MAX_SECONDS=5184000
VAULT_OFFLINE_JWT_PRIVATE_KEY_FILE=
VAULT_OFFLINE_JWT_KID=vault-1
